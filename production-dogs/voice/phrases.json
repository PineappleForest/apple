{
 "phrases": [
  {
   "text": "Frederick the Great,",
   "start": 0.08,
   "end": 1.19
  },
  {
   "text": "King of Prussia,",
   "start": 1.21,
   "end": 2.29
  },
  {
   "text": "loved his greyhounds",
   "start": 2.31,
   "end": 3.52
  },
  {
   "text": "more than most people.",
   "start": 3.54,
   "end": 4.715
  },
  {
   "text": "He asked to be buried next to them,",
   "start": 5.27,
   "end": 6.92
  },
  {
   "text": "on the terrace of his palace.",
   "start": 6.94,
   "end": 8.176
  },
  {
   "text": "Instead,",
   "start": 8.82,
   "end": 9.266
  },
  {
   "text": "his nephew buried him in a church.",
   "start": 9.67,
   "end": 11.323
  },
  {
   "text": "Then a war moved him to a mine.",
   "start": 11.74,
   "end": 13.569
  },
  {
   "text": "Then another church.",
   "start": 14.1,
   "end": 15.51
  },
  {
   "text": "Then a castle.",
   "start": 15.53,
   "end": 16.559
  },
  {
   "text": "In nineteen ninety-one,",
   "start": 17.1,
   "end": 18.47
  },
  {
   "text": "two hundred and five years late,",
   "start": 18.49,
   "end": 20.55
  },
  {
   "text": "he finally got his spot.",
   "start": 20.57,
   "end": 22.3
  },
  {
   "text": "Right next to the dogs.",
   "start": 22.32,
   "end": 23.368
  },
  {
   "text": "People still leave potatoes on his grave.",
   "start": 24.09,
   "end": 26.28
  },
  {
   "text": "Long story.",
   "start": 26.3,
   "end": 26.844
  },
  {
   "text": "Some friends are worth the wait.",
   "start": 27.52,
   "end": 29.269
  },
  {
   "text": "Jenny on Feeloy won't make you wait.",
   "start": 29.41,
   "end": 31.386
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 31.56,
   "end": 33.132
  }
 ]
}