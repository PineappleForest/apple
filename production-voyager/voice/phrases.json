 "phrases": [
  {
   "text": "In nineteen ninety,",
   "start": 0.06,
   "end": 1.39
  },
  {
   "text": "Voyager 1 was leaving home forever.",
   "start": 1.41,
   "end": 3.593
  },
  {
   "text": "Before it went,",
   "start": 4.18,
   "end": 5.17
  },
  {
   "text": "Carl Sagan asked for one favour:",
   "start": 5.19,
   "end": 6.888
  },
  {
   "text": "turn around,",
   "start": 7.7,
   "end": 8.338
  },
  {
   "text": "and take a picture of us.",
   "start": 8.56,
   "end": 9.599
  },
  {
   "text": "It did.",
   "start": 10.27,
   "end": 10.598
  },
  {
   "text": "The whole Earth",
   "start": 11.22,
   "end": 11.98
  },
  {
   "text": "was smaller than one pixel.",
   "start": 12.0,
   "end": 13.657
  },
  {
   "text": "Thirty-four minutes later,",
   "start": 14.2,
   "end": 15.51
  },
  {
   "text": "they switched its cameras off.",
   "start": 15.53,
   "end": 16.71
  },
  {
   "text": "It never saw home again.",
   "start": 17.32,
   "end": 18.286
  },
  {
   "text": "It's still out there.",
   "start": 19.18,
   "end": 20.272
  },
  {
   "text": "So far away now,",
   "start": 20.41,
   "end": 21.423
  },
  {
   "text": "a hello takes a whole day to reach it.",
   "start": 21.67,
   "end": 23.818
  },
  {
   "text": "Feeling far from everyone?",
   "start": 24.52,
   "end": 25.94
  },
  {
   "text": "Jenny on Feeloy answers right away.",
   "start": 25.96,
   "end": 28.05
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 28.47,
   "end": 29.961
  }
