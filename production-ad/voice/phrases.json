 "phrases": [
  {
   "text": "In seventeen twenty-seven,",
   "start": 0.09,
   "end": 1.464
  },
  {
   "text": "Helen Morrison of Manchester put an ad in the newspaper.",
   "start": 1.7,
   "end": 4.721
  },
  {
   "text": "She was looking for a husband.",
   "start": 5.23,
   "end": 6.45
  },
  {
   "text": "The mayor read it,",
   "start": 7.02,
   "end": 7.94
  },
  {
   "text": "and had her locked in an asylum for a month.",
   "start": 7.96,
   "end": 10.76
  },
  {
   "text": "So the story goes.",
   "start": 10.78,
   "end": 11.66
  },
  {
   "text": "Her crime?",
   "start": 12.35,
   "end": 12.746
  },
  {
   "text": "Asking for company.",
   "start": 13.31,
   "end": 14.195
  },
  {
   "text": "Today,",
   "start": 14.82,
   "end": 15.091
  },
  {
   "text": "that's just called an app.",
   "start": 15.34,
   "end": 16.252
  },
  {
   "text": "Talk to Jenny on Feeloy.",
   "start": 16.9,
   "end": 18.1
  },
  {
   "text": "No mayor will mind.",
   "start": 18.41,
   "end": 19.324
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 19.66,
   "end": 21.215
  }
 ]
